rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /movies/{movieId} {
      // Helper function to strictly validate data schema
      function isValidMovie() {
        return request.resource.data.userId == request.auth.uid
          // Required fields present
          && request.resource.data.keys().hasAll(['userId', 'title', 'director', 'genre', 'status'])
          // Whitelist: Reject any injected unexpected fields
          && request.resource.data.keys().hasOnly(['id', 'userId', 'title', 'director', 'genre', 'status', 'rating', 'favorite', 'notes', 'createdAt'])
          // Title validation: 1 - 100 chars, no whitespace-only
          && request.resource.data.title is string 
          && request.resource.data.title.trim().size() > 0 
          && request.resource.data.title.size() <= 100
          // Director validation: 1 - 60 chars, no whitespace-only
          && request.resource.data.director is string 
          && request.resource.data.director.trim().size() > 0 
          && request.resource.data.director.size() <= 60
          // Enum validations
          && request.resource.data.genre in ['Action', 'Comedy', 'Drama', 'Horror']
          && request.resource.data.status in ['Plan to Watch', 'Watching', 'Watched']
          // Optional rating: whole integer 0 to 5
          && (!('rating' in request.resource.data) || (request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5))
          // Optional favorite: boolean
          && (!('favorite' in request.resource.data) || request.resource.data.favorite is bool)
          // Optional notes: string max 300 chars
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 300))
          // Optional document ID: string
          && (!('id' in request.resource.data) || request.resource.data.id is string)
          // Optional createdAt: timestamp
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);
      }

      // 1. Chỉ người đã đăng nhập được đọc và xóa phim của chính mình
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // 2. Thêm mới: Chỉ người đã đăng nhập, đúng userId của chính mình và dữ liệu thỏa mãn schema
      allow create: if request.auth != null && isValidMovie();

      // 3. Cập nhật: Chỉ người sở hữu, không được đổi chủ sở hữu (userId), dữ liệu thỏa mãn schema
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == resource.data.userId
        && isValidMovie();
    }
  }
}
